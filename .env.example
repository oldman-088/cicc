# Server-side only; Next.js proxies browser requests to the API.
API_INTERNAL_URL=http://127.0.0.1:8000

# Experimental secure API is disabled by default; no real data or public deployment.
CICC_EXPERIMENTAL_AUTH=false
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
# CICC_RATE_LIMIT_KEY_BASE64=<base64-encoded-random-key-at-least-32-bytes>
# Supply secrets securely; do not commit a real .env or use this example as a credential.
