# CICC — System Health & Operations Dashboard
# Copy to .env and adjust. Never commit real secrets or credentials.

# ---- Backend (FastAPI, apps/api) ----
# Local SQLite file by default; use PostgreSQL in real deployments, e.g.
# postgresql+psycopg://cicc:secret@db:5432/cicc
DATABASE_URL=sqlite:///./data/ops.db
# Comma-separated list of allowed web origins for CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional immutable build revision exposed by coordination diagnostics; set from CI/deployment metadata.
CICC_BUILD_SHA=
# Maximum lifetime of one half-open domain probe lease; size above the invoke timeout/retry budget.
CICC_DOMAIN_CIRCUIT_PROBE_LEASE_S=30

# ---- Web (Next.js, apps/web) ----
# Server-side target for the /api/* proxy rewrites (browser uses relative URLs)
API_INTERNAL_URL=http://127.0.0.1:8000
# Server-only token the BFF (app/api/[...path]/route.ts) injects upstream;
# browsers never receive it. Writes through the BFF are rejected (403).
WEB_BFF_API_TOKEN=change-me
# Set to "1" to enforce Sec-Fetch-Site same-origin on BFF requests
WEB_BFF_ENFORCE_SAME_ORIGIN=1
# Optional contract declaration only; Agent 1 does not enforce tenant isolation.
# Leave empty until an owner-approved deployment boundary exists.
CICC_OPS_TRUSTED_SINGLE_TENANT=
# M26 approved write path: allows ONLY POST /api/v1/coordination/tasks through
# the BFF. Requires a separate server-only write token below. Default: off.
WEB_BFF_ALLOW_COORD_WRITE=
# Server-only write token for the single approved coordination write route
# (distinct from WEB_BFF_API_TOKEN; never exposed to the browser)
WEB_BFF_WRITE_TOKEN=change-me

# ---- Ports (local runs) ----
API_PORT=8000
WEB_PORT=3000
