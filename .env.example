# CICC — System Health & Operations Dashboard
# Copy to .env and adjust. Never commit real secrets or credentials.

# ---- Backend (FastAPI, apps/api) ----
# Local SQLite file by default; use PostgreSQL in real deployments, e.g.
# postgresql+psycopg://cicc:secret@db:5432/cicc
DATABASE_URL=sqlite:///./data/ops.db
# Comma-separated list of allowed web origins for CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Web (Next.js, apps/web) ----
# Server-side target for the /api/* proxy rewrites (browser uses relative URLs)
API_INTERNAL_URL=http://127.0.0.1:8000

# ---- Ports (local runs) ----
API_PORT=8000
WEB_PORT=3000
